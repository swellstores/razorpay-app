{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "types": [],
    "paths": {
